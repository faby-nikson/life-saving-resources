#!/usr/bin/env bash
set -euo pipefail

printInColor() {
  local inputColor=$1
  local textToDisplay="$2"
  local color="" reset=""
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    case $inputColor in
    red) color=$(tput setaf 1 2>/dev/null || true) ;;
    green) color=$(tput setaf 2 2>/dev/null || true) ;;
    yellow) color=$(tput setaf 3 2>/dev/null || true) ;;
    blue) color=$(tput setaf 4 2>/dev/null || true) ;;
    cyan) color=$(tput setaf 6 2>/dev/null || true) ;;
    esac
    reset=$(tput sgr0 2>/dev/null || true)
  fi
  echo "${color}${textToDisplay}${reset}"
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Git clean: remove untracked and ignored files and folders from your local git repository.
Must be run from inside a git repository.

Options:
  --remove-untracked-files   Remove untracked files and directories (git clean -df)
  --remove-ignored-files     Remove ignored files (git clean -Xf)
  --remove-merged-branches   Delete local branches already merged into main/master
  --all                      Enable all options
  -h, --help                 Show this help
EOF
}

ENABLE_ALL=false
REMOVE_UNTRACKED=false
REMOVE_IGNORED=false
REMOVE_MERGED=false

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  --all)
    ENABLE_ALL=true
    shift
    ;;
  --remove-untracked-files)
    REMOVE_UNTRACKED=true
    shift
    ;;
  --remove-ignored-files)
    REMOVE_IGNORED=true
    shift
    ;;
  --remove-merged-branches)
    REMOVE_MERGED=true
    shift
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage
    exit 1
    ;;
  esac
done

if [[ "$ENABLE_ALL" == true ]]; then
  REMOVE_UNTRACKED=true
  REMOVE_IGNORED=true
  REMOVE_MERGED=true
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a git repository." >&2
  exit 1
fi

COMMAND_START=$(date +%s)

clean_untracked_files() {
  printInColor cyan "Clean untracked files"
  git clean -df
}

clean_ignored_files() {
  printInColor cyan "Clean ignored files"
  git clean -Xf
}

remove_merged_branches() {
  printInColor cyan "Remove merged branches"
  local branches
  branches=$(git branch --merged | grep -vE '(^\*|main|master)' | sed 's/^[[:space:]]*//' || true)

  if [[ -z "$branches" ]]; then
    echo "Nothing to remove"
    return
  fi

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    echo "$branch"
    git branch -d "$branch"
  done <<<"$branches"

  git fetch --prune
}

if [[ "$REMOVE_UNTRACKED" == true ]]; then
  clean_untracked_files
fi

if [[ "$REMOVE_IGNORED" == true ]]; then
  clean_ignored_files
fi

if [[ "$REMOVE_MERGED" == true ]]; then
  remove_merged_branches
fi

ELAPSED=$(($(date +%s) - COMMAND_START))
printInColor yellow "Command ended in ${ELAPSED}s"
